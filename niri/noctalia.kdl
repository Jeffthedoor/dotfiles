layout {

    focus-ring {
        active-color   "#dab9ff"
        inactive-color "#16111b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#dab9ff"
        inactive-color "#16111b"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#dab9ff"
        inactive-color "#8022de"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#dab9ff80"
    }
}

recent-windows {
    highlight {
        active-color "#dab9ff"
        urgent-color "#ffb4ab"
    }
}
